# Structural example only. Replace reserved example URLs before a real build.
COMPOSE_PROJECT_NAME=ue6-local
WEB_CONTEXT=../ue6dejunio-web
IA_CONTEXT=../ue6dejunio-ia
WEB_PORT=8080
VITE_API_URL=http://localhost:8080/api
DB_NAME=ue_6_de_junio
DB_ADMIN_USERNAME=ue6_admin
DB_USERNAME=ue6
UE6_DATABASE_MODE=fresh
# Files must exist before up; Docker must never create missing secret/model directories.
DB_PASSWORD_FILE=./secrets/db-password
DB_ADMIN_PASSWORD_FILE=./secrets/db-admin-password
PREDICTION_TOKEN_FILE=./secrets/prediction-token
JWT_PUBLIC_KEY_FILE=./secrets/public.pem
JWT_PRIVATE_KEY_FILE=./secrets/private.pem
MODEL_DIRECTORY=../ue6dejunio-ia/models
# Browser requests use the web container's /api reverse proxy.
CORS_ORIGINS=http://localhost:8080
FRONTEND_RESET_URL=http://localhost:8080/auth/reset-password
MAIL_HOST=smtp.example.invalid
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.invalid
BOOTSTRAP_DIRECTOR_EMAIL=
BOOTSTRAP_DIRECTOR_PASSWORD=
BOOTSTRAP_DIRECTOR_CI=
BOOTSTRAP_DIRECTOR_NAMES=
BOOTSTRAP_DIRECTOR_LAST_NAMES=
